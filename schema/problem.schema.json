{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capacityatlas.org/api/problem.schema.json",
  "title": "Capacity Atlas problem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "updated",
    "summary",
    "tags",
    "model",
    "quantity",
    "capacity",
    "bounds",
    "formalization",
    "references"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "abbreviation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "partially-solved",
        "solved"
      ]
    },
    "featured": {
      "type": "boolean"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "features",
        "quantity",
        "knowledge"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/tagsNonempty"
        },
        "features": {
          "$ref": "#/$defs/tags"
        },
        "quantity": {
          "$ref": "#/$defs/tagsNonempty"
        },
        "knowledge": {
          "$ref": "#/$defs/tagsNonempty"
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "description"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "law",
        "assumptions"
      ],
      "properties": {
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "law": {
          "type": "string",
          "minLength": 3
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "symbol",
        "units"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "criterion": {
          "type": "string"
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "display"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exact",
            "characterization",
            "bounds",
            "region"
          ]
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "string"
        },
        "lower": {
          "type": "string"
        },
        "upper": {
          "type": "string"
        },
        "conjectured": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "bounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "direction",
          "relation",
          "method",
          "year",
          "references"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "direction": {
            "enum": [
              "lower",
              "upper",
              "exact",
              "inner-region",
              "outer-region",
              "linear-encoder-exact"
            ]
          },
          "relation": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "conditions": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "references": {
            "$ref": "#/$defs/references"
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "event",
          "references"
        ],
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "event": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "bottleneck",
        "progress"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "bottleneck": {
          "type": "string"
        },
        "progress": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "subproblems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "status"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "open",
                  "in-progress",
                  "done"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "formalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "proofs"
      ],
      "properties": {
        "statement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "language",
            "claims",
            "files"
          ],
          "properties": {
            "status": {
              "enum": [
                "none",
                "definitions",
                "statement"
              ]
            },
            "language": {
              "const": "Lean"
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "status",
                  "version",
                  "description"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "kind": {
                    "enum": [
                      "definition",
                      "achievability",
                      "converse",
                      "exact-capacity",
                      "capacity-bounds",
                      "structural"
                    ]
                  },
                  "status": {
                    "enum": [
                      "stated",
                      "open",
                      "proved"
                    ]
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              }
            },
            "notes": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "role": {
                          "enum": [
                            "statement",
                            "short-proof"
                          ]
                        }
                      },
                      "required": [
                        "role"
                      ]
                    },
                    "then": {
                      "required": [
                        "claim_id"
                      ]
                    }
                  }
                ],
                "required": [
                  "path",
                  "declaration",
                  "role",
                  "description"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^lean/.+\\.lean$"
                  },
                  "declaration": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "enum": [
                      "definition",
                      "statement",
                      "short-proof",
                      "test",
                      "shared-api"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 3
                  },
                  "claim_id": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            }
          }
        },
        "proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "claim_id",
              "status",
              "system",
              "repository",
              "commit",
              "url",
              "file",
              "declaration",
              "claim_version"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "claim_id": {
                "$ref": "#/$defs/id"
              },
              "status": {
                "enum": [
                  "partial",
                  "complete"
                ]
              },
              "system": {
                "const": "Lean"
              },
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "declaration": {
                "type": "string",
                "minLength": 1
              },
              "claim_version": {
                "type": "integer",
                "minimum": 1
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "references": {
      "$ref": "#/$defs/references"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "tagsNonempty": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
